{
  "extends": ["nitro/tsconfig"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "#utils/*": ["server/utils/*"],
      "#services/*": ["server/services/*"],
      "#repositories/*": ["server/repositories/*"],
      "#models/*": ["server/models/*"],
      "#schemas/*": ["server/schemas/*"]
    }
  }
}
